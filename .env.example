APP_ENV=production
# Vacío usa el origen actual; configura la URL si está en un subdirectorio.
APP_URL=
# Base MySQL administrada desde phpMyAdmin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roboti
DB_USERNAME=roboti
DB_PASSWORD=
# SQLite es opcional, únicamente para pruebas locales explícitas.
# SQLITE_PATH=storage/roboti.sqlite
# Confirmar con el propietario antes de configurar.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
